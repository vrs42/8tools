# 30,     31,     32,     33,
  "VR12", "",     "RX02", "",
# 34,     35,     36,     37,
  "",     "",     "DUMP", "RL02"
);
sub TypeName {
  local($dev) = @_;
  local($type) =  ($ttbl[$dev]&0777) >> 3;
  return $devicetype[$type] if $devicetype[$type];
  return sprintf(" %02o", $type);
}
