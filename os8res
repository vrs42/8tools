foreach $dev (@devices) {
  @dev = unpack("C*", $dev);
  $hash1 = (077 & shift @dev) << 6;
  $hash1 += (077 & shift @dev) if @dev;
  $hash2 = 0;
  $hash2 = (077 & shift @dev) << 6 if @dev;
  $hash2 += (077 & shift @dev) if @dev;
  if ($hash2) {
    $hash1 += $hash2;
    $hash1 |= 04000;
  }
  $hash1 &= 07777;
  if (defined $devname{$hash1}) {
    printf STDERR "Hash value: 0%o\n", $hash1;
    warn "Hash collision: $dev and $devname{$hash1}";
  }
  $devname{$hash1} = $dev;
}

#
# There are enough special cases to warrant a function here.
# (For instance, TDA0: and SDB0: have the same hash.)
$tty  = 000; # Device types, for differentiation.
$tc08 = 016;
$linc = 017;
$td8e = 021;
$rl02 = 037;
$sdsk = 064;
sub DevName {
  local($dev, $hash) = @_;
  local($type);

  # Deal with the unambiguous cases first.
  return $devname{$hash} if defined $devname{$hash};

  # Disambiguation requires the device types to be known.
  die "Forgot to load ttbl" unless @ttbl;
  $type =  ($ttbl[$dev]&0777) >> 3;
  # Special cases need disambiguation.
  # When in doubt, fail through.
  if ($hash == 04004) {
    # Hash collision: PDP and HDX
  }
  if ($hash == 04042) {
    # Hash collision: N210 and LPTR
  }
  if ($hash == 04365) {
    # Hash collision: R21C and R01E
  }
  if ($hash == 04431) {
    # Hash collision: RX2A and CSAF
  }
  if ($hash == 04512) {
    # Hash collision: SX12 and RX22
  }
  if ($hash == 04513) {
    # Hash collision: RX23 and DIAB
  }
  if ($hash == 04515) {
    # Hash collision: WIND and RL3A
  }
  if ($hash == 04524) {
    # Hash collision: LTY and DTA
  }
  if ($hash == 04613) {
    # Hash collision: R2SY and DTA7
    return "DTA7" if $type == $tc08;
    return "DTA7" if $type == $td8e;
  }
  if ($hash == 04731) {
    # Hash collision: "OS8F", "RX5A", and "TEST"
  }
  if ($hash == 05033) {
    # Hash collision: DSDH and BUFF
  }
  if ($hash == 05404) {
    # Hash collision: VT50 and TD8
    return "TD8" if $type == $td8e;
    return "VT50";
  }
  if ($hash == 05406) {
    # Hash collision: TD8B and TA8E
    return "TD8B" if $type == $td8e;
  }
  if ($hash == 05420) {
    # Hash collision: TM8C and KLAD
  }
  if ($hash == 05524) {
    # Hash collision: TTY and LTA
    return "TTY" if $type == $tty;
    return "LTA" if $type == $linc;
  }
  if ($hash == 05610) {
    # Hash collision: VC8E and LTA4
    return "LTA4" if $type == $linc;
    return "VC8E";
  }
  if ($hash == 06362) {
    # Hash collision: RBA0 and R0AB
  }
  if ($hash == 06413) {
    # Hash collision: RXA3 and DK0
  }
  if ($hash == 06564) {
    # Hash collision: SDB0 and R0CD
    return "SDB0" if $type == $sdsk;
  }
  if ($hash == 06565) {
    # Hash collision: SDB1 and R1CD
    return "SDB1" if $type == $sdsk;
  }
  if ($hash == 06611) {
    # Hash collision: RXC1 and DIR
  }
  if ($hash == 07077) {
    # Hash collision: WNA1 and FL23
  }
  if ($hash == 07205) {
    # Hash collision: WNB7 and DEV
  }
  # The original, I think, printed the octal hashcode in parenthesis.
  # We attempt to create some 3 or 4 letter name that would hash
  # correctly, allowing the user to access the device.
  $c2 = $hash & 077; # 3 character name, if possible.
  $c4 = 0;
  # Is c2 alphanumeric?
  if ($c2 > 071) {
    # Make c4 a digit
    $c4 = $c2 >> 1;
    $c4 = 060 + ($c2 & 07);
    $c2 -= $c4;
  } elsif (($c2 < 057) && ($c2 > 032)) {
    $c4 = 033 - $c2;
    $c2 -= $c4;
  }
  $c1 = ($hash&03600) >> 1;
  $c3 = ($hash&03700) - $c1;
  $c1 = $c1 >> 6;
  $c3 = $c3 >> 6;
  $c1 += 0100 unless $c1 & 040;
  $c2 += 0100 unless $c2 & 040;
  $c3 += 0100 unless $c3 & 040;
  return sprintf"(%c%c%c%c)", $c1, $c2, $c3, $c4;
  return "???";
}

#
# Extract the table of hashed names.
#
$ntbl = $usr[036];
for ($i = 0; $i < 15; $i++) {
  $ntbl[$i] = $usr[$ntbl+$i];
