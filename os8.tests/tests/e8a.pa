PACKC,	ISZ PACK
	JMP I PACK

PACKCH,	0	/ CHAR TO PACK
PACKX,	0	/ TRISTATE: 0 CHAR 1, 1 CHAR 2, -1 CHAR 3
PACK0,	0	/ PACKED WORD 0
PACK1,	0	/ PACKED WORD 1
PACKP,	0	/ -> PLACE IN IOBUF

/ SAVE FILE COMMAND. 
SVFILE,	0
	TAD [BUF		/ WRBEG = BUF
	DCA WRBEG
	TAD [BUFEND		/ WREND = BUFEND
	DCA WREND
	TAD (FILENM		/ WRITE TO ACTIVE FILE
