	TAD [SRCHP		/ SKIP OVER NL
	JMS INC15
	JMP NLFWDA

/ COUNT NL CHARS FROM GAP TO WRBEG ADD RESULT TO WRFSIZ
NLREV,	0
	JMS SREVGP
NLREVA,	TAD [NL			/ NEXT NL
	JMS SREV
	JMP I NLREV
	TAD (SRCHP		/ SRCHP >= WRBEG?
