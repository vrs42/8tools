	FAIL
	JMS SETPM		/ FIND SHORTER STRING
	JMS SFWDPT
	JMS SCHSTR
	FAIL			/ MUST BE FOUND
	JMS GOFWD		/ GO THERE
	JMS ERMLT		/ ERASE CHAR FROM MODE LINE
	JMP ISA

ISNXT,	TAD [SRCHP		/ FIND NEXT OCCURANCE
	JMS SNE15; BUFEND	/ AT END OF BUFFER?
	JMP ISB
	TAD [SRCHP		/ NO, ADVANCE 1
