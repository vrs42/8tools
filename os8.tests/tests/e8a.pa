ISD,	STA 			/ MARK EMPTY SEARCH STRING
	DCA I ISP

ISA,	JMS UPDATE
	JMS SFWDPT		/ START FROM POINT

ISC,	JMS RDTTY
	TAD [-BS		/ BACKSPACE?
	SNA
	JMP ISBS
