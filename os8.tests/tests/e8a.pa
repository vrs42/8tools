/ COUNT NL CHARS FROM POINT TO WREND ADD RESULT TO WRFSIZ
NLFWD,	0
	JMS SFWDPT
NLFWDA,	TAD [NL			/ NEXT NL
	JMS SFWD
	JMP I NLFWD
	TAD [SRCHP		/ SRCHP < WREND?
