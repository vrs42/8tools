	JMS INC15
	TAD [SRCHP		/ AT END OF BUFFER?
	JMS SNE15; BUFEND
	JMP FWORDC
	TAD [SRCHP		/ NO, GET CHAR
	JMS GET15
	JMS SKIPAN		/ ALPHANUMERIC?
	JMP FWORDC
	JMP FWORDB

FWORDC,	ISZ FWORD
	JMP I FWORD

