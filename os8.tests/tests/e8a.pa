ISB,	TAD [BELL		/ NOT FOUND
	JMS WRTTY
	JMP ISA

ISNF,	TAD [BELL		/ NOT FOUND
	JMS WRTTY
	STA			/ REMOVE CHAR FROM SEARCH STRING
