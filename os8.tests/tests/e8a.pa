/ INCREMENTAL SEARCH COMMAND
ISRCH,	0
	ISZ ISRCH		/ CAN'T FAIL
	JMS CLRMLT		/ PROMPT
	TAD (ISMSG
	JMS WR6
	WRMLT

	TAD (SSTRNG		/ INIT SEARCH STRING POINTER
