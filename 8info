#
# Look up PDP-8 files in the online database.
# BUGBUG: This implementation requires the 'curl' package to be installed.
#
$urlhome = "https://svn.so-much-stuff.com/svn/trunk/pdp8/shadb";
$urlhome = "https://www.so-much-stuff.com/pdp8/trunk/pdp8/shadb";
sub urlcat {
  local($name) = @_;
#warn "fetch $urlhome/$name\n";
  if (! -x "/usr/bin/curl") {
    die "try 'sudo apt install curl' first\n";
  }
  return `curl -s '$urlhome/$name'`;
}

$mode = 0; # Do hash lookup.
foreach $f (@ARGV) {
  if ($mode == 0) {
    # Hash the file contents.
    ($hash) = split(/\s+/, `sha256sum $f`);
    $name = &urlcat($hash); chop $name;
    if ($name =~ /404 Not Found/) {
      print "$f:\nNo hash found\n" if $name =~ /404 Not Found/;
      next;
    }
#   $name = "..." if $name =~ /[\n.]*$/;
  } else {
    $name = $f; 
  }
  # At this point we have a name to try.
#warn "$name\n";
  $data = &urlcat($name);
warn "$name" if $data eq "";
  $data .= "\n" unless substr($data, -1) eq "\n";
  $data = "No data found\n" if $data =~ /404 Not Found/;
  print "$f:\n$data";
}
