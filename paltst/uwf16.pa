	0		/PARTIAL PRODUCT
	TAD SGNTST	/SUM HIGH ORDER PARTS
	MQL		/DISCARD FIVE
	SZL
	ISZ EX1		/ACCUMULATE CARRIES

	TAD HORD	/A*F
	DCA .+3
	TAD OVR1
	SWP MUY
	0
