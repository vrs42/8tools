 948 013403  7204          CLA RAL         /R/W BIT INTO AC11
 949 013404  1217          TAD DCAXR1      /IF WRITE MAKE DCA XR2 ELSE XR1
 950 013405  3223          DCA DCASPT      /SAVE WHERE WE NEED IT
 951 013406  2270          ISZ RETLOC      /BUMP TO LOCATION (ALWAYS 1400 FROM USR)
 952 013407  2270          ISZ RETLOC      /BUMP TO BLOCK NUMBER
 953 013410  1670          TAD I RETLOC    /GET IT
 954 013411  2270          ISZ RETLOC      /BUMP TO ERROR RETURN
 955 013412  2270          ISZ RETLOC      /NOW TO GOOD RETURN (WE WONT FAIL)
