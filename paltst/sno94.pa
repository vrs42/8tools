PTNAME,	0

PTNAM1,	JMS I	RDPOOL		/READ A CHAR
	  JMP I	PTNAME		/NONE - DONE
	SNA			/STRDEL?
	JMP	PTNAM2
	JMS I	PUTCHR		/NO - PUT IT
	JMP	PTNAM1		/AGAIN

PTNAM2,	ISZ	PTNAME
	JMP I	PTNAME		/DONE


