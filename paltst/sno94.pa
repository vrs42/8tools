	TAD	INDEX7		/GET SINGLES PLACE
	TAD	C260		/ASCIIIZE
	DCA I	INDEX1		/PUT THAT
	JMP I	CVD		/DONE

CVD4,	TAD	C240		/TENS A ZERO - USE A SPACE
	JMP	CVD3
