	DCA	DEL		/CLEAR DEL
	DCA	LITFND		/LITERAL FOUND FLAG
	TAD	NC10
	DCA	T3		/COUNT FOR ACCUM
	TAD	ACUMM
	DCA	INDEX1		/SETUP PTR
	TAD	ACUMM
	DCA	INDEX7
	TAD	NC10
	DCA	TX
	DCA I	INDEX7		/CLEAR ACCUM
	ISZ	TX
	JMP	.-2		/ALL OF IT

