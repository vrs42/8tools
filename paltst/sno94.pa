	JMS I	PUTOC
	TAD	(RETURN-1
	JMS I	WRSTR
	NONE
	JMS I	PUTOC		/PUT END OF STRING
	TAD	(RETURN-1
	JMS I	WRSTR
	JMP	CLOS10		/DO THE NEXT STRING

