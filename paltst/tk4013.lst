 123               
 124                       DICL=10^DISDEV+6001
 125                       DISD=10^DISDEV+6002
 126                       DILX=10^DISDEV+6003
 127                       DILY=10^DISDEV+6004
 128                       DIXY=10^DISDEV+6005
 129                       DILE=10^DISDEV+6006
 130                       DIRE=10^DISDEV+6007
 131               
