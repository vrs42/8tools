 135                       TENKSF=10^INTEN+6001
 136                       TENKIE=10^INTEN+6005
 137                       TENKRB=10^INTEN+6006
 138               
 139               /KL8E OUTPUT COMMANDS
 140               
 141                       TENTFL=10^OUTTEN+6000
 142                       TENTSF=10^OUTTEN+6001
 143                       TENTCF=10^OUTTEN+6002
 144                       TENTLS=10^OUTTEN+6006
