DOUTIT,	CLR			/WRITE ROUTINE
	STC	LPB
	SET	SKIP2;	SKIP1
	JMP	SDATAF		/SET DF
	LDA I;	27
	XSK I	SKIP2		/SKIP 2 CONTROL WORDS
	SKP
	JMP	OGETIT		/PREPARE TO WRITE
	SWD			/SKIP ON WORD FLAG
	JMP	.-1
