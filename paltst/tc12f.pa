	JMP	.-1
	IOB;	6154		/CS TO TB
WRIOFF,	SWD			/NOW WAIT TILL LAST IS OPT AND WELL
	SKP
	JMP	.-2
	SWD			/NEXT WORD ALL SET???
	JMP	.-1		/NOPE. WAIT
	SWD			/NEXT WORD THERE. WAIT TILL IT PASSES.
	SKP
	JMP	.-2		/ITS PAST. LAST WORD IS NOW OUT COMPLETEL
	LDA I;	226		/YEP. TURN OFF THE WRITTERS.
	IOB;	6152
WRIDUN, LDA I;	0001		/PREPARE TO WRITE NEXT BLK	
