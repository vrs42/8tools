DINIT,	SET	SKIP2;	SKIP1	/READ ROUTINE
	CLR
	STC	LPB
	JMP	SDATAF		/JUST SET DF
	XSK I	SKIP2		/SKIP 3 CONTROL WORDS
	SKP
	JMP	IGETCK		/GET REV CS
