/
/
/
/
/
/
/
DEEP,	SBM			/COMES HERE IF BLOCK < 4
	JMP	.-1
	TAC			/BN TO AC
	JMP	INIT		/SHUFFLE IT
	AZE			/BLOCK 0?
	JMP	BACKWARD	/NOT YET!
	SET I	COUNT1;	-13	/THIS DELAY ALLOWS US TO FIND THE BLK GOING FWD
	STC	COUNT0
	XSK I	COUNT0
	JMP	.-1
	XSK I	COUNT1
	JMP	.-3
	JMP	FORWARD
