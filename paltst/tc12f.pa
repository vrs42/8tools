/
RDEAGN,	CLR			/PARITY ERROR
	ADD	SIZE		/DECR ADDRESS
	ADA I;	1	   	/BY 1 BLOCK
	LAM;	COREL1
	CLR		 	/CLR LINK
	LDA;	FBLOCK
	ADA I;	-3
	APO I
	JMP	BACKWARD
	JMP	FORWARD
