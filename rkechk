sub crc {
  foreach $b (@_) {
    $crc = $crc16Table[($crc ^ $b) & 0xFF] ^ ($crc >> 8);
  }
}

#
# Compare ".rke" format to ".dsk" format.
#

while (@ARGV) {
  $f = shift @ARGV;
  open(RKE, $f) || die "$f: $!";
  binmode(RKE);

  $o = shift @ARGV;
  open(DSK, $o) || die "$o: $!";
  binmode(DSK);

  #
  # Read in the RKE file header.
  read(RKE, $buf, 0x16D) || die "$f header: $!";
  ($magic, $version, $name, $desc, $date, $cont, $br, $nc, $ns, $nh, $us)
    = unpack("a10a4a11a200a20a100NNNNN", $buf);
#warn "$magic, $version, $name, $desc, $date, $cont, $br, $nc, $ns, $nh, $us\n";
  die "$f: not rke format " unless $magic == "\x89RK05\r\n\x1A";
  die "$f: cyls != 203" unless $nc == 203;
  die "$f: spt != 16" unless $ns == 16;
  die "$f: heads != 2" unless $nh == 2;
  # At this point it looks like PDP-8 RK05 media.

  #
  # Now, iterate over the data sectors, checking that the
  # data encoded is the same.
  #
  $sectors = 0;
  while (read(RKE, $buf, 4) == 4) {
    ($tts, $dbits) = unpack("SS", $buf);
    $sectors++;
    #
    # Read a data bit blob of length $dbits.
    #
    $words = $dbits / 16;
    $words++ if $dbits % 16; # RKE pads to 16 bit multiple
    read(RKE, $buf, 2*$words) || die "$f data read: $!";
    @buf = unpack("C*", $buf);
    #
    # RK8E: Discard 16 bits for header (cyl<<5)
    #
    $b1 = shift @buf;
    $b2 = shift @buf;
    $crc = 0; # CRC begins AFTER header
    die "$#buf" unless @buf > 384;
    #
    # Unpack the words of data for this sector.
    @words = ();
    for ($i = 0; $i < 128; $i++) { # 128 word pairs per sector
      # Unpack a doubleword (3 bytes)
      $b1 = shift @buf;
      $b2 = shift @buf;
      $b3 = shift @buf;
      &crc($b1, $b2, $b3);
      $w1 = ($b3 << 16) + ($b2 << 8) + $b1;
      $w2 = $w1 >> 12;
      $w1 = $w1 & 07777;
      push(@words, $w1, $w2);
    }
    $rkecrc = (shift @buf) + ((shift @buf)<<8);
    warn "RKE CRC sector $sectors: $crc (computed) <> $rkecrc (read)\n"
      unless $crc == $rkecrc;
    #
    # Remaining words must be postamble, and therefore 0000.
    foreach $b1 (@buf) {
      die "postamble sector $sectors: $b1 is nonzero" unless $b1 == 0;
    }
    #
    # At this point, we read a sector from the RKE file.
    # Now read the sector from the DSK file and compare them.
    #
    read(DSK, $buf, 2*256) || die "DSK: $!";
    @buf = unpack("S*", $buf);
    for ($i = 0; $i < 256; $i++) {
      die "mismatch: $words[$i] <> $buf[$i]" unless $words[$i] == $buf[$i];
    }
  }
  #
  # At this point, check we have done exactly the right number of sectors.
  #
  die "sector count incorrect: $sectors" unless $sectors = $nc*$ns*$nh;
}
