      }
      delete($files[$i]);
   }
}

foreach (@files) {
   if (exists $ignorefiles{$_}) {
      next;
   }
   #print "$_\n";
   if (defined $_) {
      $fn = $_;
      next if ($fn eq ".");
      next if ($fn eq "..");
      addfile($fn, $dirpath);
   }
