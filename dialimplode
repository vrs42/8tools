writeindex();

#Pad to correct size if needed
seek(OUTPUT, 0, SEEK_END);
if (tell(OUTPUT) < $tapeblocks * $bsize) {
   seek(OUTPUT, $tapeblocks * $bsize - 1, SEEK_SET) or die "Failed pad seek $!";
   print OUTPUT chr(0);
}
