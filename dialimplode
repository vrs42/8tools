%index = ();
$indexentries = 63;

$bsize = 0400 * 2;
for $i (0 .. $#sixbit) {
  $sixbitrev[ord($sixbit[$i])] = $i;
}

# Read list of files to specify order to create files 
$fn = "$dirpath/.order";
if (-e $fn) {
   open(INPUT, "<$fn") || die "$fn: $!";
   while (<INPUT>) {
