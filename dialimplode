        "H",   "I", "J", "K", "L", "M", "N", "O",   # 01x
        "P",   "Q", "R", "S", "T", "U", "V", "W",   # 02x
        "X",   "Y", "Z", "[", "\\","]", "^", "\r",  # 03x
        " ",   "!", '"', "\n","\$","%", "?", "\t",  # 04x
        "(",   ")", "*", "+", ",", "-", ".", "/",   # 05x
